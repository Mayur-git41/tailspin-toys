---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames } from '../lib/games';
import { getAllPublishers } from '../lib/publishers';

export const prerender = true;

const db = getDatabase();
const games = await getAllGames(db);
const categories = await getAllCategories(db);
const publishers = await getAllPublishers(db);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      <form method="get" class="mb-8 rounded-xl border border-slate-700 bg-slate-900/60 p-6" data-testid="game-filters">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label for="category-filter" class="mb-2 block text-sm font-medium text-slate-200">Categories</label>
            <select
              id="category-filter"
              name="category"
              multiple
              class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-800 p-3 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="category-filter"
            >
              {categories.map((category) => <option value={category.id}>{category.name}</option>)}
            </select>
          </div>
          <div>
            <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-200">Publishers</label>
            <select
              id="publisher-filter"
              name="publisher"
              multiple
              class="min-h-32 w-full rounded-lg border border-slate-600 bg-slate-800 p-3 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>
        </div>
        <div class="mt-4 flex flex-wrap gap-3">
          <button
            type="submit"
            class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="apply-filters"
          >
            Apply filters
          </button>
          <a
            href="/"
            class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="clear-filters"
          >
            Clear filters
          </a>
        </div>
      </form>

      <p class="mb-4 text-sm text-slate-400" data-testid="filter-result-count" aria-live="polite">
        Showing <span data-testid="visible-game-count">{games.length}</span> of {games.length} games
      </p>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          <p class="col-span-full hidden rounded-lg border border-slate-700 bg-slate-800 p-6 text-center text-slate-300" data-testid="no-filter-results">
            No games match the selected filters.
          </p>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const count = document.querySelector<HTMLElement>('[data-testid="visible-game-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-filter-results"]');

  if (form && count && noResults) {
    const params = new URLSearchParams(window.location.search);
    const selectedCategories = params.getAll('category');
    const selectedPublishers = params.getAll('publisher');

    for (const option of form.querySelectorAll<HTMLOptionElement>('option')) {
      const select = option.parentElement;
      option.selected =
        (select instanceof HTMLSelectElement &&
          select.name === 'category' &&
          selectedCategories.includes(option.value)) ||
        (select instanceof HTMLSelectElement &&
          select.name === 'publisher' &&
          selectedPublishers.includes(option.value));
    }

    const matches = (card: HTMLElement): boolean => {
      const categoryMatches =
        selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublishers.length === 0 || selectedPublishers.includes(card.dataset.publisherId ?? '');
      return categoryMatches && publisherMatches;
    };

    let visibleCount = 0;
    for (const card of cards) {
      const visible = matches(card);
      card.hidden = !visible;
      if (visible) visibleCount += 1;
    }

    count.textContent = String(visibleCount);
    noResults.classList.toggle('hidden', visibleCount !== 0);
  }
</script>
